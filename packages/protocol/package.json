{
  "name": "@jimcast/protocol",
  "version": "0.1.0",
  "description": "Shared wire-format types for jimcast-core <-> plugin communication (webview<->host over postMessage, backend<->host over stdio NDJSON).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch"
  },
  "devDependencies": {
    "tsdown": "^0.22.2",
    "typescript": "^5.6.0"
  }
}
